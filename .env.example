# Kopiera till .env och justera vid behov: cp .env.example .env
# .env läses in av run-local.sh (och committas ALDRIG — ligger i .gitignore)

# Port för den lokala servern
PORT=5001

# Sätt till 1 för auto-reload och felsidor under utveckling
FLASK_DEBUG=1

# Lokal databasfil (skapas automatiskt vid första start)
DB_PATH=verkstad.db

# Lokal mapp för CSV-backuper (undviker /home/data som inte finns på macOS)
BACKUP_DIR=./.backups

# Lösenord till superadmin-panelen (krävs för att appen ska starta)
SUPERADMIN_PASSWORD=revvbase-super-2026

# Valfritt: krävs bara om du vill testa utgående mail
# RESEND_API_KEY=
